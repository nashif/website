---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <style>
      body {
        max-width: 42rem;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }
      nav a {
        margin-right: 1rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/blog/`}>Blog</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
