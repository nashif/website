---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import { site } from '../data/site';
import home from '../data/home.json';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <!-- [00] Hero -->
  <Section top={false} inner="px-6 pt-16 pb-20 lg:pt-24 lg:pb-28 max-md:px-5 overflow-hidden" label="Hero">
    <div class="grid-bg" style="--gx:74%;--gy:50%" aria-hidden="true"></div>
    <div class="relative max-w-[760px]">
      <p class="label"><b>[00]</b> {home.hero.label}</p>
      <h1 class="mt-5 text-[clamp(42px,5.6vw,68px)] leading-[1.02] font-bold tracking-[-0.045em]">{home.hero.title}</h1>
      <p class="mt-6 max-w-[48ch] text-[16px] leading-[1.6] text-steel max-md:text-[15px]">{home.hero.lede}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a href={site.cta.href} class="btn btn-primary max-md:w-full">{site.cta.label} -&gt;</a>
        <a href={site.secondary.href} class="link text-[15px]">{site.secondary.label} -&gt;</a>
      </div>
    </div>
  </Section>

  <!-- [01] Latest posts -->
  <Section label="Latest posts">
    <div class="flex items-end"><p class="label"><b>[01]</b> latest posts</p><a href="/blog" class="ml-auto link text-[13px]">All posts -&gt;</a></div>
    <ul class="mt-6 border-t border-rule">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`} class="group grid grid-cols-[140px_130px_1fr_auto_auto] max-md:grid-cols-[1fr_auto] gap-x-6 gap-y-1 items-center py-[18px] border-b border-rule">
            <time class="text-[13px] text-smoke max-md:order-2 max-md:col-span-2" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <span class="text-[11px] uppercase tracking-[0.06em] text-steel max-md:hidden">{p.data.category}</span>
            <span class="text-[16px] max-md:text-[15px] text-ink group-hover:underline underline-offset-4">{p.data.title}</span>
            <span class="text-[12px] text-smoke max-md:hidden">{p.data.readingTime} min</span>
            <span class="text-stone font-bold group-hover:text-ink" aria-hidden="true">-&gt;</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <CtaSection />
</Base>
