---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog · Planux">
  <h1 class="mb-4">Blog</h1>
  <div class="list-group list-group-flush">
    {posts.map((post) => (
      <a href={`${base}/blog/${post.id}/`} class="list-group-item list-group-item-action px-0 py-3">
        <div class="d-flex justify-content-between align-items-baseline">
          <h2 class="h5 mb-1">{post.data.title}</h2>
          <small class="text-body-secondary">{post.data.pubDate.toISOString().slice(0, 10)}</small>
        </div>
        <p class="mb-0 text-body-secondary">{post.data.description}</p>
      </a>
    ))}
  </div>
</Base>
